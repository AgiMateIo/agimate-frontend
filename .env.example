# Base URL of the AgiMate API gateway.
#
# Only used when the app runs on localhost (or during SSR) — a deployed
# instance derives the gateway from its own hostname, so production needs no
# build-time configuration. See src/utils/api-url.ts.
#
# Defaults to http://api.agimate.lc:8000/ when unset.
NEXT_PUBLIC_API_BASE_URL=http://api.agimate.lc:8000/

# Public origin of this frontend, no trailing slash — the MCP OAuth client
# document (/connections/oauth/client.json) derives its client_id and redirect
# URI from it. They must equal the backend's APP_CONNECTORS_MCP_OAUTH_* byte for
# byte; set those two variables here instead to override the derived values.
#
# Defaults to https://agimate.io when unset — any other domain must set it.
# Not needed locally: the OAuth handshake requires a public HTTPS origin.
# APP_PUBLIC_ORIGIN=https://agimate.io
